          }
        },
        "required": [
          "file",
          "row",
          "column",
          "rules"
        ],
        "additionalProperties": false
      },
      "description": "Invariants that each corrected value must satisfy in future iterations, e.g. 'capacity > 0' or 'status in (active, inactive)'."
