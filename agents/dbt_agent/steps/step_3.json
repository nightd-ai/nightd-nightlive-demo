      "enum": [
        "SUCCESS",
        "FAILURE"
      ]
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "row": {
            "type": "integer"
          },
          "column": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
